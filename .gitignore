# OS
.DS_Store
Thumbs.db

# Playwright MCP scratch output — the one sink for throwaway screenshots.
# Prune it freely; anything worth keeping gets promoted to research/.
.playwright-mcp/

# Editor
.vscode/
.idea/
*.swp

# Real page snapshots and everything mkharness.py generates from them — all
# regenerable, and copies of physiologie.cc's own pages. Only the generator
# itself is tracked.
.test/
dev/*
!dev/mkharness.py

# Superseded Strategy-B prototype (src/ is the source of truth now)
proto/

# Backstop: no image belongs at the repo root. Real assets live under icons/,
# research/ and fonts/; throwaway screenshots stay in .playwright-mcp/.
/*.png
/*.jpeg
/*.jpg
